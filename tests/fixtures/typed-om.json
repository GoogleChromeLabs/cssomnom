    {
      "description": "Parsing calc(1px + 2% + 3em)",
      "property": "width",
      "input": "calc(1px + 2% + 3em)",
      "expected": "new CSSMathSum(CSS.px(1), CSS.percent(2), CSS.em(3))"
    }
  ],
