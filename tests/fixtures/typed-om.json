    {
      "description": "CSSKeywordValue from CSSOM modified through \"value\" setter serializes correctly",
      "input": "result",
      "expected": "lemon"
    },
    {
      "description": "CSSUnparsedValue containing strings serializes to its tokenized contents",
      "input": "new CSSUnparsedValue(['lem', 'on', 'ade'])",
      "expected": "lem/**/on/**/ade"
    },
    {
      "description": "CSSUnparsedValue containing variable references",
      "input": "new CSSUnparsedValue([new CSSVariableReferenceValue('--A', new CSSUnparsedValue([new CSSVariableReferenceValue('--B')])), new CSSVariableReferenceValue('--C')])",
      "expected": "var(--A,var(--B))var(--C)"
    },
    {
      "description": "CSSUnparsedValue with mix of strings and variable references",
      "input": "new CSSUnparsedValue(['foo', 'bar ', new CSSVariableReferenceValue('--A', new CSSUnparsedValue(['baz ', new CSSVariableReferenceValue('--B'), 'lemon'])), new CSSVariableReferenceValue('--C', new CSSUnparsedValue(['ade']))])",
      "expected": "foo/**/bar var(--A,baz var(--B)lemon)var(--C,ade)"
    }
