{
  "atPropertyRules": [
    {
      "name": "--valid",
      "syntax": "<color> | none",
      "inherits": false,
      "initialValue": "red",
      "input": "@property --valid {\n    syntax: \"<color> | none\";\n    inherits: false;\n    initial-value: red;\n  }",
      "expected": {
        "cssText": "@property --valid {syntax: \"<color> | none\"; inherits: false;initial-value: red;}",
        "syntax": "<color> | none",
        "inherits": false,
        "initialValue": "red",
        "valid": true
      }
    },
    {
      "name": "--valid-reverse",
      "syntax": "<length>",
      "inherits": true,
      "initialValue": "0px",
      "input": "@property --valid-reverse {\n    initial-value: 0px;\n    inherits: true;\n    syntax: \"<length>\";\n  }",
      "expected": {
        "cssText": "@property --valid-reverse {syntax: \"<length>\"; inherits: true;initial-value: 0px;}",
        "syntax": "<length>",
        "inherits": true,
        "initialValue": "0px",
        "valid": true
      }
    },
    {
      "name": "--valid-universal",
      "syntax": "*",
      "inherits": false,
      "input": "@property --valid-universal {\n    syntax: \"*\";\n    inherits: false;\n  }",
      "expected": {
        "cssText": "@property --valid-universal {syntax: \"*\"; inherits: false;}",
        "syntax": "*",
        "inherits": false,
        "valid": true
      }
    },
    {
      "name": "--valid-whitespace",
      "syntax": " <color># ",
      "inherits": false,
      "initialValue": "red, blue",
      "input": "@property --valid-whitespace {\n    syntax: \" <color># \";\n    inherits: false;\n    initial-value: red, blue;\n  }",
      "expected": {
        "cssText": "@property --valid-whitespace {syntax: \" <color># \"; inherits: false;initial-value: red, blue;}",
        "syntax": " <color># ",
        "inherits": false,
        "initialValue": "red, blue",
        "valid": true
      }
    },
    {
      "name": "--vALId",
      "syntax": "<color> | none",
      "inherits": false,
      "initialValue": "red",
      "input": "@property --vALId {\n    syntax: \"<color> | none\";\n    inherits: false;\n    initial-value: red;\n  }",
      "expected": {
        "cssText": "@property --vALId {syntax: \"<color> | none\"; inherits: false;initial-value: red;}",
        "syntax": "<color> | none",
        "inherits": false,
        "initialValue": "red",
        "valid": true
      }
    },
    {
      "name": "--no-descriptors",
      "inherits": false,
      "input": "@property --no-descriptors {\n\n  }",
      "expected": {
        "valid": false
      }
    },
    {
      "name": "--no-syntax",
      "inherits": false,
      "initialValue": "red",
      "input": "@property --no-syntax {\n    inherits: false;\n    initial-value: red;\n  }",
      "expected": {
        "valid": false
      }
    },
    {
      "name": "--no-inherits",
      "syntax": "<color> | none",
      "inherits": false,
      "initialValue": "red",
      "input": "@property --no-inherits {\n    syntax: \"<color> | none\";\n    initial-value: red;\n  }",
      "expected": {
        "valid": false
      }
    },
    {
      "name": "--no-initial-color-value",
      "syntax": "<color> | none",
      "inherits": false,
      "input": "@property --no-initial-color-value {\n    syntax: \"<color> | none\";\n    inherits: false;\n  }",
      "expected": {
        "valid": false
      }
    },
    {
      "name": "--no-initial-universal-value",
      "syntax": "*",
      "inherits": false,
      "input": "@property --no-initial-universal-value {\n    syntax: \"*\";\n    inherits: false;\n  }",
      "expected": {
        "cssText": "@property --no-initial-universal-value {syntax: \"*\"; inherits: false;}",
        "syntax": "*",
        "inherits": false,
        "valid": true
      }
    },
    {
      "name": "--syntax-only",
      "syntax": "<color> | none",
      "inherits": false,
      "input": "@property --syntax-only {\n    syntax: \"<color> | none\";\n  }",
      "expected": {
        "valid": false
      }
    },
