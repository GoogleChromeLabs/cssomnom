{
  "name": "cssomnom",
  "version": "0.1.3",
  "description": "Fast, spec-compliant CSS Object Model (CSSOM) and Typed OM parser in pure TypeScript",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GoogleChromeLabs/cssomnom.git"
  },
  "bugs": {
    "url": "https://github.com/GoogleChromeLabs/cssomnom/issues"
  },
  "homepage": "https://github.com/GoogleChromeLabs/cssomnom#readme",
  "keywords": [
    "css",
    "cssom",
    "typed-om",
    "parser",
    "ast",
    "stylesheet",
    "w3c"
  ],
  "type": "module",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "src",
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./ts": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=24.11.0"
  },
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "build": "tsup && tsup --config tsup.browser.config.ts && tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm run preflight && pnpm run build",
    "test": "pnpm run preflight",
    "test:node": "node --test --test-reporter=dot 'tests/**/*.test.ts'",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "check:safe-exec": "node scripts/ci/check-safe-exec.ts",
    "preflight": "pnpm typecheck && pnpm lint && pnpm check:safe-exec && pnpm test:node",
    "fixtures:generate": "node scripts/external_suites/extract_all.ts",
    "external:extract": "node scripts/external_suites/extract_all.ts",
    "baselines:prune": "node scripts/baselines/prune_resolved_failures.ts",
    "test:wpt-typed-om:chrome": "pnpm run wpt:browser:chrome",
    "test:wpt-typed-om:firefox": "pnpm run wpt:browser:firefox",
    "wpt:browser:chrome": "node scripts/wpt/browser/run.ts --browser=chrome",
    "wpt:browser:firefox": "node scripts/wpt/browser/run.ts --browser=firefox",
    "wpt": "node --max-old-space-size=1024 scripts/wpt/node/cli.ts",
    "wpt:run": "node --max-old-space-size=1024 scripts/wpt/node/cli.ts run",
    "wpt:crawl": "node --max-old-space-size=1024 scripts/wpt/node/cli.ts run --write-progress-markdown",
    "wpt:progress": "node --max-old-space-size=1024 scripts/wpt/node/cli.ts run --write-progress-markdown",
    "wpt:baseline": "node --max-old-space-size=1024 scripts/wpt/node/cli.ts run --write-passing-set-baseline",
    "wpt:verify": "node --max-old-space-size=1024 scripts/wpt/node/cli.ts run --verify-exact-baseline",
    "wpt:cluster": "node --max-old-space-size=1024 scripts/wpt/node/cli.ts cluster",
    "wpt:diff": "node --max-old-space-size=1024 scripts/wpt/node/cli.ts diff",
    "wpt:node": "node --max-old-space-size=1024 scripts/wpt/node/run.ts",
    "submodules:update": "git submodule update --init --recursive",
    "submodules:upgrade": "git submodule update --init --remote && pnpm run submodules:update",
    "codegen": "node scripts/codegen/generate_all.ts",
    "maintain": "pnpm update --latest && pnpm run submodules:upgrade && pnpm run codegen && pnpm run external:extract && pnpm run preflight"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@webref/css": "^8.7.0",
    "linkedom": "^0.18.13",
    "mdn-data": "^2.28.1",
    "oxlint": "^1.74.0",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2"
  }
}
