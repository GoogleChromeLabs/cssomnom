{
  "name": "cssomnom",
  "version": "0.1.9",
  "description": "Fast, spec-compliant CSS Object Model (CSSOM) and Typed OM parser in pure TypeScript",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GoogleChromeLabs/cssomnom.git"
  },
  "bugs": {
    "url": "https://github.com/GoogleChromeLabs/cssomnom/issues"
  },
  "homepage": "https://github.com/GoogleChromeLabs/cssomnom#readme",
  "keywords": [
    "css",
    "cssom",
    "typed-om",
    "parser",
    "ast",
    "stylesheet",
    "w3c"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/index.js",
    "./src/cascade.ts",
    "./src/css-namespace.ts",
    "./src/MediaParser.ts",
    "./src/PropertyRegistry.ts",
    "./src/typed-om/**"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "!dist/cssomnom.iife.global.js",
    "!dist/browser-entry.d.ts",
    "src",
    "!src/browser-entry.ts"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./parse": {
      "types": "./dist/parse-entry.d.ts",
      "import": "./dist/parse.js",
      "default": "./dist/parse.js"
    },
    "./parser-api": {
      "types": "./dist/parser-api.d.ts",
      "import": "./dist/parser-api.js",
      "default": "./dist/parser-api.js"
    },
    "./ts": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@12.5.1+sha512.e3f305bc784a2bc89f5ad3b6138889470fae8d2af5f36b61216ec91c2c3d64089775f9de38aac331044ea40f245cb0d5666392dfdf65824e1907ef6a2c62de5f",
  "scripts": {
    "build": "tsdown && tsc -p tsconfig.build.json",
    "prepare": "git config core.hooksPath .githooks",
    "prepublishOnly": "pnpm run preflight && pnpm run build",
    "test": "pnpm run preflight",
    "test:node": "node --test --test-reporter=dot 'tests/**/*.test.ts' 'skills/**/*.test.ts'",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "check:safe-exec": "node scripts/ci/check-safe-exec.ts",
    "check:spec-anchors": "node scripts/ci/check-spec-anchors.ts",
    "bench": "node scripts/benchmarks/parser.bench.ts",
    "bench:compare": "node scripts/benchmarks/compare.ts",
    "preflight": "pnpm typecheck && pnpm lint && pnpm check:safe-exec && pnpm check:spec-anchors && pnpm test:node",
    "fixtures:generate": "node scripts/external_suites/extract_all.ts",
    "external:extract": "node scripts/external_suites/extract_all.ts",
    "baselines:prune": "node scripts/baselines/prune_resolved_failures.ts",
    "test:wpt-typed-om:chrome": "pnpm run wpt:browser:chrome",
    "test:wpt-typed-om:firefox": "pnpm run wpt:browser:firefox",
    "wpt:browser:chrome": "node scripts/wpt/browser/run.ts --browser=chrome",
    "wpt:browser:firefox": "node scripts/wpt/browser/run.ts --browser=firefox",
    "wpt": "node --max-old-space-size=4096 scripts/wpt/node/cli.ts",
    "wpt:run": "node --max-old-space-size=4096 scripts/wpt/node/cli.ts run",
    "wpt:crawl": "node --max-old-space-size=4096 scripts/wpt/node/cli.ts run --write-progress-markdown",
    "wpt:progress": "node --max-old-space-size=4096 scripts/wpt/node/cli.ts run --write-progress-markdown",
    "wpt:baseline": "node --max-old-space-size=4096 scripts/wpt/node/cli.ts run --write-passing-set-baseline",
    "wpt:verify": "node --max-old-space-size=4096 scripts/wpt/node/cli.ts run --verify-exact-baseline",
    "wpt:cluster": "node --max-old-space-size=4096 scripts/wpt/node/cli.ts cluster",
    "wpt:diff": "node --max-old-space-size=4096 scripts/wpt/node/cli.ts diff",
    "wpt:parity": "node --max-old-space-size=4096 scripts/wpt/node/cli.ts parity",
    "wpt:fetch-upstream": "node --max-old-space-size=4096 scripts/wpt/node/cli.ts fetch-upstream",
    "wpt:node": "node --max-old-space-size=4096 scripts/wpt/node/run.ts",
    "submodules:update": "git submodule update --init --recursive",
    "submodules:upgrade": "git submodule update --init --remote && pnpm run submodules:update",
    "codegen": "node scripts/codegen/generate_all.ts",
    "maintain": "pnpm update --latest && pnpm run submodules:upgrade && pnpm run codegen && pnpm run external:extract && pnpm run preflight && pnpm run wpt:baseline"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@webref/css": "^8.7.8",
    "linkedom": "^0.18.14",
    "mdn-data": "^2.37.2",
    "oxlint": "^1.89.0",
    "puppeteer-core": "^25.16.0",
    "tsdown": "^0.23.2",
    "typescript": "^7.0.2"
  }
}
