{
  "name": "cssomnom",
  "version": "0.1.0",
  "type": "module",
  "exports": {
    "import": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "build": "tsup",
    "test": "pnpm run preflight",
    "test:node": "node --test --test-reporter=dot 'tests/**/*.test.ts'",
    "typecheck": "tsc --noEmit",
    "preflight": "pnpm typecheck && pnpm lint && pnpm test:node",
    "lint": "oxlint",
    "fixtures:generate": "node scripts/extract_external_suites.ts",
    "external:extract": "node scripts/extract_external_suites.ts",
    "baselines:prune": "node scripts/prune_resolved_failures.ts",
    "wpt:sandbox": "node scripts/run_wpt_sandbox.ts",
    "wpt:baseline": "node scripts/run_wpt_crawler.ts --update-baseline",
    "wpt:progress": "node scripts/run_wpt_crawler.ts --update-progress",
    "submodules:update": "git submodule update --init --recursive",
    "submodules:upgrade": "git submodule update --init --remote && pnpm run submodules:update",
    "codegen": "node scripts/generate_all.ts",
    "maintain": "pnpm update --latest && pnpm run submodules:upgrade && pnpm run codegen && pnpm run external:extract && pnpm run preflight"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@webref/css": "^8.7.0",
    "linkedom": "^0.18.13",
    "mdn-data": "^2.28.1",
    "oxlint": "^1.74.0",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2"
  }
}
